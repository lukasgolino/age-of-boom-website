---
import "@fontsource-variable/inter";
import "@fontsource/pixelify-sans/700.css";
import "@fontsource/pixelify-sans/400.css";
import "@fontsource/silkscreen/400.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const og = new URL(`${base}img/og.png`, Astro.site).href;
// Game UI images (tools/build_site_assets.py) as CSS variables, so CSS stays base-path independent.
const ui = (f: string) => `url(${base}sprites/ui/${f}.png)`;
const vars = [
  `--water-tile:url(${base}sprites/water.png)`,
  `--img-panel:${ui("panel_panel")}`,
  `--img-banner:${ui("banner_banner")}`,
  `--img-btn:${ui("button_normal")}`,
  `--img-btn-hover:${ui("button_hover")}`,
  `--img-btn-pressed:${ui("button_pressed")}`,
  `--img-bubble:${ui("bubble_bubble")}`,
].join(";");
const fontFace = `@font-face{font-family:"Boom Pixel";src:url(${base}fonts/boom-pixel.woff2) format("woff2");font-display:swap;}`;
// Structured data (schema.org) for search engines and AI assistants.
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "Age of Boom",
      "url": "https://ageofboom.online/"
    },
    {
      "@type": "VideoGame",
      "name": "Age of Boom",
      "url": "https://ageofboom.online/",
      "description": "Loud, top-down pixel-art naval combat. Out-sail other captains, get your broadside on them first and sink them. Online deathmatch, co-op Last Stand and solo voyages.",
      "genre": [
        "Action",
        "Naval combat",
        "Multiplayer"
      ],
      "gamePlatform": "PC",
      "applicationCategory": "Game",
      "author": {
        "@id": "https://lukasgolino.com/#me"
      },
      "creator": {
        "@id": "https://lukasgolino.com/#me"
      },
      "operatingSystem": "Windows",
      "playMode": [
        "MultiPlayer",
        "CoOp",
        "SinglePlayer"
      ],
      "keywords": "naval combat game, pirate ship game, pixel art, multiplayer, co-op, indie game, Godot"
    },
    {
      "@type": "Person",
      "@id": "https://lukasgolino.com/#me",
      "name": "Lukas Golino",
      "url": "https://lukasgolino.com/",
      "sameAs": [
        "https://github.com/lukasgolino"
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" style={vars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060f1a" />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="preload" href={`${base}fonts/boom-pixel.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:inline set:html={fontFace}></style>
    {<script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <slot />
    <script>
      // Reveal-on-scroll.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // Muted loops (video[data-lazy], sources in data-src): load when near the viewport, play only while visible.
      const vio = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              if (v.dataset.lazy !== undefined) {
                v.querySelectorAll<HTMLSourceElement>("source[data-src]").forEach((s) => (s.src = s.dataset.src!));
                delete v.dataset.lazy;
                v.load();
              }
              v.play().catch(() => {});
            } else v.pause();
          }
        },
        { rootMargin: "300px 0px" },
      );
      document.querySelectorAll<HTMLVideoElement>("video[data-lazy], video.lazy-play").forEach((v) => vio.observe(v));
    </script>
    <!-- Cloudflare Web Analytics: cookieless, no consent banner needed. Production builds only, so `astro dev` visits aren't counted. -->
    {import.meta.env.PROD && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "b0467e56b3dc43a6bc7644175ff55021"}'></script>
    )}
    <!-- Umami: cookieless too; adds per-visit page journeys. One Umami website for all our sites (filter by Host). -->
    {import.meta.env.PROD && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="6c3ba9da-9af9-49a9-a575-90c9cace445c"></script>
    )}
  </body>
</html>
